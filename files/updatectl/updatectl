#!/usr/bin/env bash
set -euo pipefail

sysupdate=/usr/lib/systemd/systemd-sysupdate
definitions_dir=/usr/lib/sysupdate.d
state_dir=/var/lib/updatectl
cache_dir=/var/cache/updatectl

die() {
    echo "updatectl: $*" >&2
    exit 1
}

need_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

validate_version() {
    local version="$1"

    [[ "${version}" =~ ^[A-Za-z0-9._:+-]+$ ]] || die "invalid update version: ${version}"
}

usage() {
    cat <<EOF
Usage: updatectl COMMAND [VERSION]

Commands:
  check             Print the newest available update version
  list [VERSION]    Show available and installed versions
  update [VERSION]  Stage usr with zsync, verify it, and apply with sysupdate
  apply [VERSION]   Alias for update
  pending           Check whether an installed update is pending reboot
  reboot            Reboot if an installed update is pending
  help              Show this help
EOF
}

sysupdate() {
    [ -x "${sysupdate}" ] || die "missing ${sysupdate}"
    "${sysupdate}" --no-pager "$@"
}

source_path_from_definition() {
    local file="$1"
    awk '
        /^\[/ { in_source = ($0 == "[Source]") }
        in_source && /^[[:space:]]*Path[[:space:]]*=/ {
            sub(/^[^=]*=/, "")
            gsub(/^[[:space:]]+|[[:space:]]+$/, "")
            print
            exit
        }
    ' "${file}"
}

definition_file() {
    local name="$1"
    local candidate

    for candidate in "${definitions_dir}/${name}.transfer" "${definitions_dir}/${name}.conf"; do
        if [ -f "${candidate}" ]; then
            echo "${candidate}"
            return
        fi
    done

    die "missing ${definitions_dir}/${name}.transfer or ${definitions_dir}/${name}.conf"
}

current_usr_image() {
    local mount_source
    mount_source="$(findmnt -n -o SOURCE /usr 2>/dev/null || true)"
    if [ -n "${mount_source}" ] && [ -b "${mount_source}" ]; then
        echo "${mount_source}"
        return
    fi

    for candidate in /run/initramfs/usr.squashfs /usr.squashfs; do
        if [ -e "${candidate}" ]; then
            readlink -f "${candidate}"
            return
        fi
    done

    die "could not find current usr squashfs seed"
}

available_usr_payload() {
    local version="$1"
    local index="$2"

    awk -v version="${version}" '
        $2 ~ /^usr_/ && $2 ~ /_[0-9A-Fa-f-]+[.]squashfs([.]xz)?$/ {
            candidate = $2
            sub(/^usr_/, "", candidate)
            sub(/_[0-9A-Fa-f-]+[.]squashfs([.]xz)?$/, "", candidate)
            if (candidate == version) {
                if ($2 ~ /[.]squashfs$/) {
                    raw = $2
                } else if (compressed == "") {
                    compressed = $2
                }
            }
        }
        END {
            if (raw != "") {
                print raw
            } else if (compressed != "") {
                print compressed
            }
        }
    ' "${index}"
}

payload_match_pattern() {
    local payload="$1"

    case "${payload}" in
        *.squashfs)
            echo "usr_@v_@u.squashfs"
            ;;
        *.squashfs.xz)
            echo "usr_@v_@u.squashfs.xz"
            ;;
        *)
            die "unsupported usr payload name: ${payload}"
            ;;
    esac
}

fetch_file() {
    local url="$1"
    local output="$2"

    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "${url}" -o "${output}"
    else
        wget -q -O "${output}" "${url}"
    fi
}

verify_sha256() {
    local index="$1"
    local payload="$2"

    awk -v payload="${payload}" '$2 == payload { print; found = 1 } END { exit found ? 0 : 1 }' "${index}" |
        sha256sum -c - >&2
}

url_exists() {
    local url="$1"

    if command -v curl >/dev/null 2>&1; then
        curl -fsIL "${url}" >/dev/null 2>&1
    else
        wget -q --spider "${url}" >/dev/null 2>&1
    fi
}

stage_usr_payload() {
    local version="$1"
    local usr_conf
    local update_url sha_file payload payload_url zsync_url stage payload_path seed

    need_cmd sha256sum
    need_cmd zsync

    usr_conf="$(definition_file avyos-usr)"
    update_url="$(source_path_from_definition "${usr_conf}")"
    [ -n "${update_url}" ] || die "could not read update URL from ${usr_conf}"
    update_url="${update_url%/}/"

    install -d -m 0755 "${state_dir}" "${cache_dir}"
    sha_file="${cache_dir}/SHA256SUMS"
    fetch_file "${update_url}SHA256SUMS" "${sha_file}"

    payload="$(available_usr_payload "${version}" "${sha_file}")"
    [ -n "${payload}" ] || die "no usr squashfs payload for version ${version} in ${update_url}SHA256SUMS"

    stage="${cache_dir}/stage-${version}"
    rm -rf "${stage}"
    install -d -m 0755 "${stage}"

    payload_url="${update_url}${payload}"
    zsync_url="${payload_url}.zsync"
    payload_path="${stage}/${payload}"

    if url_exists "${zsync_url}"; then
        if [[ "${payload}" == *.squashfs ]]; then
            seed="$(current_usr_image)"
            echo "Using ${seed} as zsync seed for ${payload}" >&2
            (
                cd "${stage}"
                zsync -q -i "${seed}" -o "${payload}" "${zsync_url}"
            )
        else
            echo "Using zsync for compressed usr payload ${payload}" >&2
            (
                cd "${stage}"
                zsync -q -o "${payload}" "${zsync_url}"
            )
        fi
    else
        echo "No zsync metadata for ${payload}; downloading full usr image" >&2
        fetch_file "${payload_url}" "${payload_path}"
    fi

    [ -s "${payload_path}" ] || die "failed to stage ${payload}"
    (cd "${stage}" && verify_sha256 "${sha_file}" "${payload}")

    rm -f "${state_dir}/usr-stage"
    ln -s "${stage}" "${state_dir}/usr-stage"
    echo "${payload_path}"
}

write_delta_definitions() {
    local stage="$1"
    local pattern="$2"
    local target="$3"
    local file dest

    install -d -m 0755 "${target}"

    for file in "${definitions_dir}"/*.transfer "${definitions_dir}"/*.conf; do
        [ -e "${file}" ] || continue
        dest="$(basename "${file}")"
        dest="${dest%.conf}.transfer"
        case "$(basename "${file}")" in
            avyos-usr.conf|avyos-usr.transfer)
                awk -v stage="${stage}" -v pattern="${pattern}" '
                    /^\[/ { in_source = ($0 == "[Source]") }
                    in_source && /^[[:space:]]*Type[[:space:]]*=/ {
                        print "Type=regular-file"
                        next
                    }
                    in_source && /^[[:space:]]*Path[[:space:]]*=/ {
                        print "Path=" stage
                        next
                    }
                    in_source && /^[[:space:]]*MatchPattern[[:space:]]*=/ {
                        print "MatchPattern=" pattern
                        next
                    }
                    { print }
                ' "${file}" >"${target}/${dest}"
                ;;
            *)
                cp "${file}" "${target}/${dest}"
                ;;
        esac
    done
}

update_system() {
    local version="${1:-}"
    local staged_payload payload_pattern stage temp_defs

    if [ -z "${version}" ]; then
        if ! version="$(sysupdate check-new)"; then
            echo "No update available"
            return 0
        fi
        version="$(printf '%s\n' "${version}" | sed -n '1p')"
    fi
    [ -n "${version}" ] || die "empty update version"
    validate_version "${version}"

    staged_payload="$(stage_usr_payload "${version}")"
    payload_pattern="$(payload_match_pattern "$(basename "${staged_payload}")")"
    stage="$(dirname "${staged_payload}")"
    temp_defs="$(mktemp -d /run/updatectl-definitions.XXXXXX)"
    trap 'rm -rf "${temp_defs}"' RETURN
    write_delta_definitions "${stage}" "${payload_pattern}" "${temp_defs}"

    echo "Applying AvyOS ${version} with systemd-sysupdate"
    sysupdate "--definitions=${temp_defs}" update "${version}"
}

command="${1:-update}"
shift || true

case "${command}" in
    check)
        sysupdate check-new
        ;;
    list)
        sysupdate list "$@"
        ;;
    update|apply)
        update_system "$@"
        ;;
    pending)
        sysupdate pending
        ;;
    reboot)
        sysupdate reboot
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
