{{ define "section_markdown" -}}
<section class="doc-ref-shell">
  <header class="doc-ref-hero">
    <h1>{{ .Title }}</h1>
    <p class="muted mono doc-path">{{ .RelPath }}</p>
  </header>
  <section class="doc-section-card">
    <div class="doc-markdown">{{ markdown .Markdown }}</div>
  </section>
</section>
{{- end }}
