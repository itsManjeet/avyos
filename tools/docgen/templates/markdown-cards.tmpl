{{ define "markdown_cards" -}}
<section class="doc-card-stack">
  {{- if .Sections }}
    {{- range .Sections }}
    <section class="doc-section-card">
      {{- if .Title }}
      <h2>{{ .Title }}</h2>
      {{- end }}
      <div class="doc-markdown">{{ markdown .Content }}</div>
    </section>
    {{- end }}
  {{- else }}
    <section class="doc-section-card">
      <div class="doc-markdown"><p>No content.</p></div>
    </section>
  {{- end }}
</section>
{{- end }}
