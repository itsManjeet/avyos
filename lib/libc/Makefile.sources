SOURCES += $(COMMON_SOURCES)

ifeq ($(TARGET_ARCH),aarch64)
SOURCES := $(filter-out $(AARCH64_OVERRIDES),$(SOURCES))
SOURCES += $(AARCH64_SOURCES)
endif

ifeq ($(TARGET_ARCH),arm)
SOURCES := $(filter-out $(ARM_OVERRIDES),$(SOURCES))
SOURCES += $(ARM_SOURCES)
endif

ifeq ($(TARGET_ARCH),i386)
SOURCES := $(filter-out $(I386_OVERRIDES),$(SOURCES))
SOURCES += $(I386_SOURCES)
endif

ifeq ($(TARGET_ARCH),riscv32)
SOURCES := $(filter-out $(RISCV32_OVERRIDES),$(SOURCES))
SOURCES += $(RISCV32_SOURCES)
endif

ifeq ($(TARGET_ARCH),riscv64)
SOURCES := $(filter-out $(RISCV64_OVERRIDES),$(SOURCES))
SOURCES += $(RISCV64_SOURCES)
endif

ifeq ($(TARGET_ARCH),sh)
SOURCES := $(filter-out $(SH_OVERRIDES),$(SOURCES))
SOURCES += $(SH_SOURCES)
endif

ifeq ($(TARGET_ARCH),x86_64)
SOURCES := $(filter-out $(X86_64_OVERRIDES),$(SOURCES))
SOURCES += $(X86_64_SOURCES)
endif

# Optional sanity check: fail fast for unsupported TARGET_ARCH.
ifneq ($(filter $(TARGET_ARCH),$(LIBC_ARCHES)),)
else
$(error Unsupported TARGET_ARCH=$(TARGET_ARCH); supported: $(LIBC_ARCHES))
endif
